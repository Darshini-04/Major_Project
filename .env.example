# Path to the Online Retail II workbook. Defaults to data/raw/online_retail_II.xlsx
PULSEIQ_DATA_PATH=data/raw/online_retail_II.xlsx
# Optional OpenAI-compatible chat completions endpoint. No key is required for local recommendations.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
